# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sinay
DB_SSLMODE=disable

# ── Server ────────────────────────────────────────────────
SERVER_PORT=8088
MIGRATIONS_DIR=migrations

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5174

# ── Paymob ────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ─────────────────────────────────────────────────
# Option A — Gmail SMTP (sends as a real @gmail.com address you own).
# SMTP_HOST set means this takes priority over Resend below.
# Requires 2-Step Verification + an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Option B — Resend (used only if SMTP_HOST above is empty).
# Sandbox mode without a verified domain can only send to the signup email.
RESEND_API_KEY=
EMAIL_FROM=SINAY <onboarding@resend.dev>

# Leave both providers empty in dev — emails are logged instead of sent.
FRONTEND_URL=http://localhost:5174
